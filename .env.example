# Public URL of the deployed site (used for SEO, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Contact form (SMTP via Nodemailer) ----
# Gmail example: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jaya.arora.tech@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact form messages are delivered
CONTACT_TO_EMAIL=jaya.arora.tech@gmail.com
